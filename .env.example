# Copy to .env. Only AWS_ACCOUNT_ID is required; everything else has defaults.
ENV_NAME=dev
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
PROJECT_NAME=pizza-voice

# Models
BEDROCK_PROMPT_MODEL=us.amazon.nova-pro-v1:0
NOVA_SONIC_VOICE_MODEL=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE_ID=Lupe

# Connect / IVR (Nova Sonic S2S only supports es_US)
CONNECT_INSTANCE_ALIAS=orders
LOCALE=es_US
CONTACT_FLOW_FILE=order-flow.json
# Claim a DID in CFN + associate it to the flow. Chile (CL) needs an AWS support case.
# Off by default: new accounts often hit the 'claimed phone numbers' instance quota.
# The synthetic WebRTC caller (scripts/call-test.py) needs no phone number.
ENABLE_PHONE_NUMBER=false
PHONE_COUNTRY_CODE=US
PHONE_TYPE=DID

# Cold starts add ~0.45-0.65 s to a voice turn. none | snapstart | provisioned (~USD 3/month per Lambda at 1).
TOOL_WARM_MODE=none
TOOL_PROVISIONED_CONCURRENCY=1

POS_API_BASE_URL=https://pos.example.com/api

# Feature flags
ENABLE_CONVERSATIONAL_AI=true
ENABLE_OBSERVABILITY=true
ENABLE_QUICKSIGHT=false
ENABLE_KNOWLEDGE_BASE=false
ENABLE_AGENTCORE_GATEWAY=true
ENABLE_AGENT_MCP_TOOLS=true

# AgentCore gateway JWT (Connect is the issuer). Leave empty to derive from the instance alias:
#   https://<PROJECT_NAME>-<CONNECT_INSTANCE_ALIAS>-<ENV_NAME>.my.connect.aws
AGENTCORE_JWT_DISCOVERY_URL=
AGENTCORE_JWT_ISSUER=
# DEBUG returns the exact JWT rejection reason — never in prod.
AGENTCORE_GATEWAY_EXCEPTION_LEVEL=

# Keep tables/buckets after `cdk destroy` (production). Default false = full cleanup.
RETAIN_DATA=false
