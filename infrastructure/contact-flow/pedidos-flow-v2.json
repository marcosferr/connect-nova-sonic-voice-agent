{
  "Version": "2019-10-30",
  "StartAction": "set-logging",
  "Metadata": {
    "entryPointPosition": {
      "x": 20,
      "y": 20
    },
    "ActionMetadata": {
      "set-logging": {
        "position": {
          "x": 160,
          "y": 20
        }
      },
      "set-recording": {
        "position": {
          "x": 360,
          "y": 20
        }
      },
      "set-voice": {
        "position": {
          "x": 560,
          "y": 20
        }
      },
      "welcome": {
        "position": {
          "x": 760,
          "y": 20
        }
      },
      "create-ai-session": {
        "position": {
          "x": 960,
          "y": 20
        }
      },
      "bind-ai-session": {
        "position": {
          "x": 1160,
          "y": 20
        }
      },
      "ai-agent": {
        "position": {
          "x": 1360,
          "y": 20
        }
      },
      "error-message": {
        "position": {
          "x": 1360,
          "y": 260
        }
      },
      "disconnect": {
        "position": {
          "x": 1600,
          "y": 20
        }
      },
      "set-session-data": {
        "position": {
          "x": 1260,
          "y": 160
        }
      }
    }
  },
  "Actions": [
    {
      "Identifier": "set-logging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Transitions": {
        "NextAction": "set-recording"
      }
    },
    {
      "Identifier": "set-recording",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": {
          "RecordedParticipants": [
            "Agent",
            "Customer"
          ]
        }
      },
      "Transitions": {
        "NextAction": "set-voice"
      }
    },
    {
      "Identifier": "set-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "Lupe",
        "TextToSpeechEngine": "Generative"
      },
      "Transitions": {
        "NextAction": "welcome"
      }
    },
    {
      "Identifier": "welcome",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Hola, bienvenido a Forno Pizza."
      },
      "Transitions": {
        "NextAction": "create-ai-session",
        "Errors": [
          {
            "NextAction": "create-ai-session",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "create-ai-session",
      "Type": "CreateWisdomSession",
      "Parameters": {
        "WisdomAssistantArn": "${WisdomAssistantArn}"
      },
      "Transitions": {
        "NextAction": "bind-ai-session",
        "Errors": [
          {
            "NextAction": "error-message",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "bind-ai-session",
      "Type": "UpdateContactData",
      "Parameters": {
        "WisdomSessionArn": "$.Wisdom.SessionArn"
      },
      "Transitions": {
        "NextAction": "set-session-data",
        "Errors": [
          {
            "NextAction": "error-message",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "set-session-data",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "${SessionDataFunctionArn}",
        "InvocationTimeLimitSeconds": "8",
        "InvocationType": "SYNCHRONOUS",
        "LambdaInvocationAttributes": {
          "customer_phone": "$.CustomerEndpoint.Address",
          "contact_id": "$.ContactId"
        },
        "ResponseValidation": {
          "ResponseType": "STRING_MAP"
        }
      },
      "Transitions": {
        "NextAction": "ai-agent",
        "Errors": [
          {
            "NextAction": "ai-agent",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "ai-agent",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": " ",
        "LexV2Bot": {
          "AliasArn": "${LexBotAliasArn}"
        },
        "LexSessionAttributes": {
          "x-amz-lex:q-in-connect:ai-agent-arn": "${AiAgentArn}",
          "x-amz-lex:q-in-connect:session-arn": "$.Wisdom.SessionArn"
        }
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "error-message",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "error-message",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Lo sentimos, tenemos un problema técnico. Por favor, vuelve a llamar en unos minutos."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
